{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fasthands.dev/contracts/loops/0.1/manifest",
  "type": "object",
  "required": ["format", "name", "version", "inputs", "steps", "output"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "loops/0.1"},
    "name": {"$ref": "#/$defs/nonempty"},
    "version": {"$ref": "#/$defs/nonempty"},
    "description": {"type": "string"},
    "inputs": {"$ref": "#/$defs/output"},
    "steps": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"oneOf": [{"$ref": "#/$defs/infer"}, {"$ref": "#/$defs/code"}]}},
    "output": true,
    "repeat": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "through", "until", "max_iterations"],
      "properties": {
        "from": {"$ref": "#/$defs/nonempty"}, "through": {"$ref": "#/$defs/nonempty"},
        "until": true, "max_iterations": {"type": "integer", "minimum": 1},
        "carry": {"type": "object", "additionalProperties": false, "required": ["initial", "next"], "properties": {"initial": true, "next": true}}
      }
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "schema": {"anyOf": [{"type": "boolean"}, {"type": "object"}, {"$ref": "#/$defs/nonempty"}]},
    "output": {"type": "object", "required": ["schema"], "additionalProperties": false, "properties": {"schema": {"$ref": "#/$defs/schema"}}},
    "requires": {"type": "array", "uniqueItems": true, "items": {"enum": ["browser", "computer", "web_search"]}},
    "infer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "input", "output", "instructions"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"}, "kind": {"const": "infer"}, "input": true,
        "output": {"$ref": "#/$defs/output"}, "instructions": {"$ref": "#/$defs/nonempty"},
        "requires": {"$ref": "#/$defs/requires"}, "complexity": {"enum": ["low", "medium", "high"]}
      }
    },
    "code": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "input", "output", "file", "runtime"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"}, "kind": {"const": "code"}, "input": true,
        "output": {"$ref": "#/$defs/output"}, "file": {"$ref": "#/$defs/nonempty"},
        "runtime": {"$ref": "#/$defs/nonempty"}, "requires": {"$ref": "#/$defs/requires"}
      }
    }
  }
}
