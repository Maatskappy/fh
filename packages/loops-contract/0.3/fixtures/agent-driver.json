{
  "packageFiles": {
    "loop.json": "{\n  \"format\": \"loops/0.3\",\n  \"name\": \"conformance-0-3\",\n  \"version\": \"1.0.0\",\n  \"inputs\": {\n    \"schema\": true\n  },\n  \"steps\": [\n    {\n      \"id\": \"draft\",\n      \"kind\": \"infer\",\n      \"requires\": [],\n      \"instructions\": \"Return JSON.\",\n      \"input\": {\n        \"from\": \"/input\"\n      },\n      \"output\": {\n        \"schema\": {\n          \"type\": \"object\",\n          \"required\": [\n            \"text\"\n          ],\n          \"properties\": {\n            \"text\": {\n              \"type\": \"string\"\n            }\n          },\n          \"additionalProperties\": false\n        }\n      }\n    },\n    {\n      \"id\": \"verify\",\n      \"kind\": \"code\",\n      \"runtime\": \"python3\",\n      \"file\": \"verify.py\",\n      \"requires\": [],\n      \"input\": {\n        \"from\": \"/steps/draft/output\"\n      },\n      \"output\": {\n        \"schema\": true\n      }\n    }\n  ],\n  \"output\": {\n    \"from\": \"/steps/verify/output\"\n  }\n}\n",
    "verify.py": "import json, sys\nx = json.load(sys.stdin)\nprint(json.dumps({'ready': x['text'] == 'ok'}))\n"
  },
