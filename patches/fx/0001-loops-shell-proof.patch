+test "fh Codex errors incomplete terminals resets deadlines and cancellation invalidate pooled sockets" {
+    const alloc = std.testing.allocator;
+    const cases = [_]TransportFixture.Reply{
+        .{ .body = "{\"error\":\"fixture\"}", .status = 503 },
+        .{ .body = "data: {\"type\":\"response.completed\",\"response\":{\"status\":\"incomplete\"}}\n\n" },
+        .{ .body = "data: [DONE]\n\n" },
+        .{ .body = "", .mode = .reset },
+        .{ .body = "", .mode = .stall },
+    };
+    for (cases, 0..) |bad, index| {
+        const replies = [_]TransportFixture.Reply{ bad, .{ .body = transport_test_body } };
+        var server = try TransportFixture.Server.init(&replies);
+        defer server.deinit();
+        try server.start();
+        const url = try server.url(alloc);
+        defer alloc.free(url);
+        const env = try TransportFixture.Env.init(e2e_endpoint_env, url);
+        defer env.deinit();
+        var scope = http_pool.Scope.init(alloc);
+        defer scope.deinit();
+        var probe: TransportProbe = .{ .timeout_ms = 80 };
+        if (probe.call(&scope)) |value| {
+            var result = value;
+            defer result.deinit(alloc);
+            try std.testing.expect(index == 0 and result == .failed);
+        } else |_| {}
+        try std.testing.expectEqual(stream_provider.DeliveryCertainty.State.possibly_sent, probe.delivery.load());
+        try std.testing.expectEqual(@as(usize, 0), scope.pool.?.freeConnectionCount());
+        probe.timeout_ms = 2000;
+        try probe.success(&scope);
+        try std.testing.expectEqual(@as(usize, 2), server.accepted.load(.acquire));
+    }
+    const replies = [_]TransportFixture.Reply{ .{ .body = "", .mode = .stall }, .{ .body = transport_test_body } };
+    var server = try TransportFixture.Server.init(&replies);
+    defer server.deinit();
+    try server.start();
+    const url = try server.url(alloc);
+    defer alloc.free(url);
+    const env = try TransportFixture.Env.init(e2e_endpoint_env, url);
+    defer env.deinit();
+    var scope = http_pool.Scope.init(alloc);
+    defer scope.deinit();
+    var probe: TransportProbe = .{};
+    const Canceller = struct {
+        fn run(peer: *TransportFixture.Server, cancel: *std.atomic.Value(bool)) void {
+            var waits: usize = 0;
+            while (peer.served.load(.acquire) == 0 and waits < 2000) : (waits += 1) io_mod.sleep(std.time.ns_per_ms);
+            cancel.store(true, .release);
+        }
+    };
+    const thread = try std.Thread.spawn(.{}, Canceller.run, .{ &server, &probe.cancel });
+    defer thread.join();
+    try std.testing.expectError(error.Cancelled, probe.call(&scope));
+    try std.testing.expectEqual(@as(usize, 0), scope.pool.?.freeConnectionCount());
+    try std.testing.expectEqual(stream_provider.DeliveryCertainty.State.possibly_sent, probe.delivery.load());
+    probe.cancel.store(false, .release);
+    try probe.success(&scope);
+    try std.testing.expectEqual(@as(usize, 2), server.accepted.load(.acquire));
+}
